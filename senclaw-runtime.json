{
  "schemaVersion": 1,
  "id": "sen-mlx",
  "name": "SenClaw MLX",
  "version": "0.1.1",
  "description": "MLX LLM runtime for SenClaw: chat + vision on Apple Silicon",
  "type": "llm-engine",
  "slots": ["mlx"],
  "formats": ["mlx"],
  "capabilities": ["chat", "vision"],
  "platforms": ["darwin-arm64"],
  "accelerator": "metal",
  "mode": "model",
  "entry": {
    "command": "bin/sen-mlx",
    "args": ["serve", "--host", "{host}", "--port", "{port}", "--model", "{model_path}"],
    "env": {}
  },
  "health": { "path": "/health", "startupTimeoutSecs": 300 },
  "api": { "openaiBase": "/v1" },
  "homepage": "https://github.com/SenClaw/sen-mlx",
  "releaseNotesUrl": "https://github.com/SenClaw/sen-mlx/releases/tag/v0.1.1",
  "license": "MIT"
}
